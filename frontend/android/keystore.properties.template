# Tech Churras — Signing config template
# INSTRUÇÕES:
#   1. Copie este arquivo: keystore.properties.template → keystore.properties
#   2. Preencha os campos abaixo com os valores reais
#   3. NUNCA commite keystore.properties ou o arquivo .jks no git
#
# Gere o keystore com:
#   keytool -genkey -v \
#     -keystore techchurras.keystore \
#     -alias techchurras \
#     -keyalg RSA \
#     -keysize 2048 \
#     -validity 10000 \
#     -dname "CN=Tech Churras, OU=Mobile, O=Tech Churras, L=Sao Paulo, ST=SP, C=BR"
#
# Salve o arquivo gerado em: frontend/android/techchurras.keystore
# Documente as senhas em:     frontend/android/.keystore-info.txt (gitignored)

storeFile=techchurras.keystore
storePassword=PREENCHA_AQUI
keyAlias=techchurras
keyPassword=PREENCHA_AQUI
