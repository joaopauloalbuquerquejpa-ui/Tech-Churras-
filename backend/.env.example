# ── Banco de dados (Supabase / Railway) ──────────────────────────────────────
# Pooler (porta 6543) — usado pelo Prisma em runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Conexão direta (porta 5432) — usado pelo prisma migrate/push
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Autenticação ─────────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
JWT_SECRET=gere-com-openssl-rand-hex-32
JWT_EXPIRES_IN=7d

# ── MercadoPago ──────────────────────────────────────────────────────────────
# APP_USR-... para produção | TEST-... para sandbox
MP_ACCESS_TOKEN=APP_USR-seu-token-aqui
# Secret do webhook — configure em MP Dashboard > Suas integrações > Webhooks
MP_WEBHOOK_SECRET=seu-webhook-secret-aqui

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_KEY=sua-service-role-key-aqui

# ── Push Notifications (VAPID) ───────────────────────────────────────────────
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=sua-vapid-public-key
VAPID_PRIVATE_KEY=sua-vapid-private-key

# ── Anthropic (Claude) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# ── Google Gemini (transcrição de áudio — nota de voz vira texto) ────────────
# Gratuito no free tier do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua-chave-gemini-aqui

# ── Z-API (WhatsApp) ─────────────────────────────────────────────────────────
ZAPI_INSTANCE=sua-instancia
ZAPI_TOKEN=seu-token
ZAPI_CLIENT_TOKEN=seu-client-token
ZAPI_ADMIN_PHONE=5511999999999

# ── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_sua-chave-aqui

# ── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=https://xxx@sentry.io/xxx

# ── Apify (descoberta de açougues via Google Maps) ────────────────────────────
# https://console.apify.com/settings/integrations — token pessoal da conta Apify.
APIFY_TOKEN=apify_api_sua-chave-aqui
# Opcional — actor de scraping do Google Maps. Padrão: compass~crawler-google-places.
APIFY_ACTOR_ID=compass~crawler-google-places

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://www.techchurras.com.br
BACKEND_URL=https://tech-churras-production.up.railway.app
# Origins permitidas no CORS (separadas por vírgula)
ALLOWED_ORIGINS=https://www.techchurras.com.br,https://tech-churras.vercel.app

# ── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=gere-com-openssl-rand-hex-32

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3333
NODE_ENV=production
