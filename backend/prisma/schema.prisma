generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  CUSTOMER
  GRILLMASTER
  BOUTIQUE
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductCategory {
  CARNE
  SAL_TEMPERO
  CARVAO
  ACOMPANHAMENTO
  BEBIDA
  OUTRO
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role          Role     @default(CUSTOMER)
  averageRating Float?
  points        Int      @default(0)
  onboardingCompleted  Boolean  @default(false)
  referredByBoutiqueId String?
  firstOrderCouponUsed Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders          Order[]  @relation("CustomerOrders")
  grillmaster     Grillmaster?
  boutique        Boutique?
  customerReviews Review[]  @relation("CustomerReviews")
  sentMessages    Message[] @relation("SentMessages")
}

model Grillmaster {
  id           String   @id @default(uuid())
  userId       String   @unique
  bio          String?
  experience   Int      @default(0)
  pricePerHour Float    @default(0)
  available    Boolean  @default(true)
  city         String
  state        String
  rating       Float    @default(0)
  approved     Boolean  @default(false)
  totalOrders  Int      @default(0)
  isChancelado Boolean  @default(false)
  specialties  String?  @default("")
  photoUrl        String?
  galleryUrls     String[] @default([])
  instagram       String?
  churrascoStyle  String?
  bringsEquipment Boolean  @default(false)
  minGuests       Int?
  maxGuests       Int?
  pixKey          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id])
  orders   Order[]
  schedule GrillmasterSchedule[]
  reviews  Review[]
}

model GrillmasterSchedule {
  id            String   @id @default(uuid())
  grillmasterId String
  date          DateTime
  available     Boolean  @default(true)
  createdAt     DateTime @default(now())

  grillmaster Grillmaster @relation(fields: [grillmasterId], references: [id])
}

model Boutique {
  id             String   @id @default(uuid())
  userId         String   @unique
  name           String
  description    String?
  city           String
  state          String
  address        String?
  phone          String?
  latitude       Float?
  longitude      Float?
  rating         Float    @default(0)
  approved       Boolean  @default(false)
  open           Boolean  @default(true)
  monthlyFee     Float    @default(369.00)
  commissionRate Float    @default(0.03)
  pixKey           String?
  logoUrl          String?
  facadeUrl        String?
  galleryUrls      String[] @default([])
  instagram        String?
  openingHours     String?
  deliveryOrPickup String?
  referralCode     String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id])
  products Product[]
  orders   Order[]
  kits     KitChurrasco[]
  reviews  Review[]
}

model KitChurrasco {
  id          String   @id @default(uuid())
  boutiqueId  String
  boutique    Boutique @relation(fields: [boutiqueId], references: [id])
  name        String
  description String
  price       Float
  minGuests   Int
  maxGuests   Int
  items       String
  createdAt   DateTime @default(now())
}

model Product {
  id            String          @id @default(uuid())
  boutiqueId    String
  name          String
  description   String?
  price         Float
  unit          String          @default("kg")
  category      ProductCategory @default(CARNE)
  available     Boolean         @default(true)
  stockQuantity Int?
  imageUrl      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  boutique   Boutique    @relation(fields: [boutiqueId], references: [id])
  orderItems OrderItem[]
}

model Order {
  id             String      @id @default(uuid())
  customerId     String
  grillmasterId  String?
  boutiqueId     String?
  status         OrderStatus @default(PENDING)
  eventDate      DateTime
  eventAddress   String
  eventHours     Int         @default(4)
  guestCount     Int
  totalPrice     Float       @default(0)
  couponCode     String?
  discountAmount Float?      @default(0)
  statusDetail          String?
  grillmasterLat        Float?
  grillmasterLng        Float?
  grillmasterLastUpdate DateTime?
  cancelledBy           String?
  cancellationReason    String?
  cancellationFee       Float?
  refundAmount          Float?
  notes                 String?
  paymentId      String?
  paymentStatus  String?
  paidAt         DateTime?
  reminder48hSent  Boolean  @default(false)
  reminder24hSent  Boolean  @default(false)
  publicShareToken String?  @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customer    User         @relation("CustomerOrders", fields: [customerId], references: [id])
  grillmaster Grillmaster? @relation(fields: [grillmasterId], references: [id])
  boutique    Boutique?    @relation(fields: [boutiqueId], references: [id])
  items       OrderItem[]
  review      Review?
  messages    Message[]
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  quantity  Float
  unitPrice Float

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Payout {
  id          String    @id @default(cuid())
  type        String
  recipientId String
  orderId     String?
  amount      Float
  commission  Float     @default(15)
  grossAmount Float
  status      String    @default("PENDING")
  weekStart   DateTime
  weekEnd     DateTime
  paidAt      DateTime?
  pixKey      String?
  notes       String?
  createdAt   DateTime  @default(now())
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String
  discountValue Float
  minOrderValue Float?
  maxUses       Int?
  usedCount     Int       @default(0)
  validUntil    DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model PointsRedemption {
  id            String   @id @default(cuid())
  userId        String
  pointsUsed    Int
  discountValue Float
  couponCode    String
  used          Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Contract {
  id              String    @id @default(cuid())
  partnerId       String
  partnerType     String
  durationMonths  Int
  status          String    @default("PENDING_SIGNATURE")
  templateVersion String    @default("1.0-minuta")
  contractText    String
  partnerName     String
  partnerDocument String
  partnerEmail    String
  partnerAddress  String
  acceptedAt      DateTime?
  acceptIp        String?
  acceptUserAgent String?
  generatedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  orderId   String
  senderId  String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id])
  sender User  @relation("SentMessages", fields: [senderId], references: [id])
}

model Review {
  id              String   @id @default(uuid())
  orderId         String   @unique
  customerId      String
  grillmasterId   String?
  boutiqueId      String?
  grillRating     Int?
  boutiqueRating  Int?
  grillComment    String?
  boutiqueComment String?
  customerRating  Int?
  customerComment String?
  photos          String[] @default([])
  createdAt       DateTime @default(now())

  order       Order        @relation(fields: [orderId], references: [id])
  customer    User         @relation("CustomerReviews", fields: [customerId], references: [id])
  grillmaster Grillmaster? @relation(fields: [grillmasterId], references: [id])
  boutique    Boutique?    @relation(fields: [boutiqueId], references: [id])
}
