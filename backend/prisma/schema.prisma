generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  CUSTOMER
  GRILLMASTER
  BOUTIQUE
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductCategory {
  CARNE
  SAL_TEMPERO
  CARVAO
  ACOMPANHAMENTO
  BEBIDA
  OUTRO
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders     Order[]      @relation("CustomerOrders")
  grillmaster Grillmaster?
  boutique   Boutique?
}

model Grillmaster {
  id           String   @id @default(uuid())
  userId       String   @unique
  bio          String?
  experience   Int      @default(0)
  pricePerHour Float    @default(0)
  available    Boolean  @default(true)
  city         String
  state        String
  rating       Float    @default(0)
  approved     Boolean  @default(false)
  totalOrders  Int      @default(0)
  specialties  String?  @default("")
  photoUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id])
  orders   Order[]
  schedule GrillmasterSchedule[]
}

model GrillmasterSchedule {
  id            String   @id @default(uuid())
  grillmasterId String
  date          DateTime
  available     Boolean  @default(true)
  createdAt     DateTime @default(now())

  grillmaster Grillmaster @relation(fields: [grillmasterId], references: [id])
}

model Boutique {
  id          String   @id @default(uuid())
  userId      String   @unique
  name        String
  description String?
  city        String
  state       String
  address     String?
  phone       String?
  latitude    Float?
  longitude   Float?
  rating      Float    @default(0)
  approved    Boolean  @default(false)
  open        Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  products Product[]
  orders   Order[]
}

model Product {
  id          String          @id @default(uuid())
  boutiqueId  String
  name        String
  description String?
  price       Float
  unit        String          @default("kg")
  category    ProductCategory @default(CARNE)
  available   Boolean         @default(true)
  imageUrl    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  boutique   Boutique    @relation(fields: [boutiqueId], references: [id])
  orderItems OrderItem[]
}

model Order {
  id            String      @id @default(uuid())
  customerId    String
  grillmasterId String?
  boutiqueId    String?
  status        OrderStatus @default(PENDING)
  eventDate     DateTime
  eventAddress  String
  eventHours    Int         @default(4)
  guestCount    Int
  totalPrice    Float       @default(0)
  notes         String?
  paymentId     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  customer    User         @relation("CustomerOrders", fields: [customerId], references: [id])
  grillmaster Grillmaster? @relation(fields: [grillmasterId], references: [id])
  boutique    Boutique?    @relation(fields: [boutiqueId], references: [id])
  items       OrderItem[]
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  quantity  Float
  unitPrice Float

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}
